<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Botão para voltar -->
    <ImageView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:src="@drawable/icon_voltar"
        android:contentDescription="@string/voltar_imagem_do_local_com_bot_es_de_navega_o_sobrepostos"/>

    <ImageView
        android:id="@+id/favorite_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/back_button"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:src="@drawable/icon_favoritos"
        android:contentDescription="@string/adicionar_aos_favoritos" />

    <FrameLayout
        android:id="@+id/image_frame"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_below="@id/back_button">

        <!-- Substitua com uma imagem padrão -->

        <ImageView
            android:id="@+id/local_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="bottom">

            <Button
                android:id="@+id/image_prev_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prev" />

            <Button
                android:id="@+id/image_next_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next" />
        </LinearLayout>
    </FrameLayout>

    <!-- Título e Rating do Local -->
    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/image_frame"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@android:color/white"
        android:elevation="6dp">

        <!-- Nome do Local -->
        <TextView
            android:id="@+id/local_name_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="Torre dos Clérigos" />

        <!-- Classificação do Local -->
        <TextView
            android:id="@+id/local_rating_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/icon_estrela"
            android:drawablePadding="4dp"
            android:text="4,6"
            android:layout_marginTop="8dp"/>

        <!-- Distância do Local -->
        <TextView
            android:id="@+id/local_distance_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/icon_novopi"
            android:drawablePadding="4dp"
            android:text="11 Km da sua localização"
            android:layout_marginTop="8dp"/>

        <!-- Informações e Comentários na mesma altura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Informações" />

            <TextView
                android:id="@+id/local_comments_text_view"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="0 Comentários" />
        </LinearLayout>

        <!-- Descrição do Local -->
        <TextView
            android:id="@+id/local_description_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição completa do local aqui..."
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</RelativeLayout>